# Copy to deploy/.env — docker compose reads it automatically.

# Managed cluster (the usual case). Use sslmode=require unless the cluster
# is reachable only over a private network.
DATABASE_URL=postgres://user:password@host:5432/ghnotify?sslmode=require

# Bundled Postgres instead: set POSTGRES_PASSWORD, point DATABASE_URL at the
# db service, and overlay docker-compose.local-db.yml when starting.
# POSTGRES_PASSWORD=
# DATABASE_URL=postgres://gh:<POSTGRES_PASSWORD>@db:5432/ghnotify?sslmode=disable

BOT_TOKEN=
BOT_USERNAME=
GITHUB_APP_ID=
GITHUB_SLUG=
GITHUB_WEBHOOK_SECRET=
PUBLIC_URL=
# openssl rand -base64 32
SECRET_KEY=
