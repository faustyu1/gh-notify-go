# Terminates TLS and forwards only the public webhook paths to the bot.
notify.example.com {
	handle /gh/webhook {
		reverse_proxy 127.0.0.1:8080
	}
	handle /gl/webhook {
		reverse_proxy 127.0.0.1:8080
	}
	# GitLab, Gitea, Forgejo, GitVerse: /hook/<provider>[/<connection>]
	handle /hook/* {
		reverse_proxy 127.0.0.1:8080
	}
	handle /github/setup {
		reverse_proxy 127.0.0.1:8080
	}
	handle {
		respond "not found" 404
	}
}
