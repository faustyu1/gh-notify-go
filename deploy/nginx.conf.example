# Прокси для GitHub App: наружу торчат только два пути, остальное — 404.
# Подставь свой домен и пути к сертификатам (например, от certbot).
#
#   GitHub App → Webhook URL: https://notify.example.com/gh/webhook
#   GitHub App → Setup URL:   https://notify.example.com/github/setup

server {
    listen 80;
    server_name notify.example.com;

    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name notify.example.com;

    ssl_certificate     /etc/letsencrypt/live/notify.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/notify.example.com/privkey.pem;

    # Лимит запроса в боте — 8 MiB, зеркалим его здесь.
    client_max_body_size 8m;

    location = /gh/webhook {
        proxy_pass         http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        # Тело нужно передать байт-в-байт: подпись HMAC считается по нему.
        proxy_request_buffering off;
    }

    location = /github/setup {
        proxy_pass         http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
    }

    location /healthz {
        proxy_pass http://127.0.0.1:8080;
        allow 127.0.0.1;
        deny all;
    }

    location / { return 404; }
}
