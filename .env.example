# Copy to .env — the binary loads it before reading the environment.
# Real environment variables always win over this file.

# Bot (from @BotFather)
BOT_TOKEN=
BOT_USERNAME=

# Postgres (SQLite is not supported)
DATABASE_URL=postgres://gh:gh@localhost:5432/ghnotify?sslmode=disable

# GitHub App
GITHUB_APP_ID=
GITHUB_SLUG=
GITHUB_PRIVATE_KEY_PATH=secrets/app.pem
GITHUB_WEBHOOK_SECRET=

# Public HTTP surface
HTTP_ADDR=:8080
PUBLIC_URL=https://example.com

# 32 random bytes, base64: openssl rand -base64 32
SECRET_KEY=

# Tunables (defaults shown)
CHAT_PER_MINUTE=20
WORKERS=4
